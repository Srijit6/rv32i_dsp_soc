n4:e -> c29:p24:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
c29:p28:e -> n5:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n5:e -> c22:p18:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
c29:p27:e -> n6:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n6:e -> c16:p13:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
