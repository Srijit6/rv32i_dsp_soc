digraph "soc_top" {
label="soc_top";
rankdir="LR";
remincross=true;
n3 [ shape=diamond, label="dsp_ready_wire", color="black", fontcolor="black"];
n4 [ shape=diamond, label="dsp_result_wire", color="black", fontcolor="black"];
n5 [ shape=diamond, label="rs2_wire", color="black", fontcolor="black"];
n6 [ shape=diamond, label="rs1_wire", color="black", fontcolor="black"];
n7 [ shape=diamond, label="inst_wire", color="black", fontcolor="black"];
n8 [ shape=diamond, label="inst_addr_wire", color="black", fontcolor="black"];
n9 [ shape=octagon, label="monitor_out", color="black", fontcolor="black"];
n10 [ shape=octagon, label="rst_n", color="black", fontcolor="black"];
n11 [ shape=octagon, label="clk", color="black", fontcolor="black"];
c15 [ shape=record, label="{{<p12> A|<p13> B}|$3\n$xor|{<p14> Y}}",  ];
c16 [ shape=record, label="{{<p12> A|<p13> B}|$2\n$xor|{<p14> Y}}",  ];
v0 [ label="1'1" ];
c22 [ shape=record, label="{{<p11> clk|<p17> rs1_in|<p18> rs2_in|<p10> rst_n|<p19> valid_in}|dsp\ndsp_coprocessor|{<p20> ready_out|<p21> result_out}}",  ];
c29 [ shape=record, label="{{<p11> clk|<p23> dsp_ready_in|<p24> dsp_result_in|<p25> inst_in|<p10> rst_n}|core\nrv32i_top|{<p26> inst_addr_out|<p27> rs1_out|<p28> rs2_out}}",  ];
c32 [ shape=record, label="{{<p30> addr|<p11> clk}|imem\ninstruction_memory|{<p31> inst}}",  ];
x1 [shape=point, ];
c15:p14:e -> x1:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
