digraph "soc_top" {
label="soc_top";
rankdir="LR";
remincross=true;
n1 [ shape=diamond, label="dsp_ready", color="black", fontcolor="black"];
n2 [ shape=diamond, label="dsp_result", color="black", fontcolor="black"];
n3 [ shape=diamond, label="dsp_valid", color="black", fontcolor="black"];
n4 [ shape=diamond, label="rs2_data", color="black", fontcolor="black"];
n5 [ shape=diamond, label="rs1_data", color="black", fontcolor="black"];
n6 [ shape=diamond, label="instruction", color="black", fontcolor="black"];
n7 [ shape=diamond, label="inst_addr", color="black", fontcolor="black"];
n8 [ shape=octagon, label="rst_n", color="black", fontcolor="black"];
n9 [ shape=octagon, label="clk", color="black", fontcolor="black"];
c15 [ shape=record, label="{{<p9> clk|<p10> rs1_in|<p11> rs2_in|<p8> rst_n|<p12> valid_in}|u_dsp\ndsp_coprocessor|{<p13> ready_out|<p14> result_out}}",  ];
c23 [ shape=record, label="{{<p9> clk|<p16> dsp_ready_in|<p17> dsp_result_in|<p18> inst_in|<p8> rst_n}|u_core\nrv32i_top|{<p19> dsp_valid_out|<p20> inst_addr_out|<p21> rs1_out|<p22> rs2_out}}",  ];
c26 [ shape=record, label="{{<p24> addr|<p9> clk}|u_imem\ninstruction_memory|{<p25> inst}}",  ];
c15:p13:e -> n1:w [color="black", fontcolor="black", label=""];
n1:e -> c23:p16:w [color="black", fontcolor="black", label=""];
c15:p14:e -> n2:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n2:e -> c23:p17:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
c23:p19:e -> n3:w [color="black", fontcolor="black", label=""];
n3:e -> c15:p12:w [color="black", fontcolor="black", label=""];
c23:p22:e -> n4:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n4:e -> c15:p11:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
c23:p21:e -> n5:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n5:e -> c15:p10:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
c26:p25:e -> n6:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n6:e -> c23:p18:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
c23:p20:e -> n7:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n7:e -> c26:p24:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n8:e -> c15:p8:w [color="black", fontcolor="black", label=""];
n8:e -> c23:p8:w [color="black", fontcolor="black", label=""];
n9:e -> c15:p9:w [color="black", fontcolor="black", label=""];
n9:e -> c23:p9:w [color="black", fontcolor="black", label=""];
n9:e -> c26:p9:w [color="black", fontcolor="black", label=""];
}
